<!DOCTYPE html>
<html class="no-js" lang="en" itemscope itemtype="http://schema.org/WebPage">
<head>
{% block head %}
  <title>Anti-XSS for PHP</title>

  {% block head_meta %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Protect your web application against XSS attacks.">
    <meta name="theme-color" content="#292c31">
    <meta name="revisit-after" content="1 days">
    <meta name="topic" content="security">
    <meta name="twitter:title" content="Anti-XSS for PHP">
    <meta property="og:locale" content="en_EN">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Anti-XSS for PHP">
  {% endblock %}

  {% block head_css %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css-min/app.css">
  {% endblock %}

  <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
{% endblock %}
</head>
<body id="page{{ page_id }}" class="{{ page_template }}">
<div class="globalWrapper">
  <header class="masthead py-5">
    <div class="container">
      <div class="row">
        <div class="col-12 clearfix">
          <h1>
            <a href="/" title="Anti-XSS for PHP">Anti-XSS for PHP</a>
          </h1>

          <p class="lead">
            { @hacker | "try to bypass this XSS filter" }
          </p>

          <h2>
            <a class="masthead--link" href="https://github.com/voku/anti-xss/" target="_blank" rel="noreferrer">github.com/voku/anti-xss</a>
          </h2>
        </div>
      </div>
    </div>
  </header>

  <nav class="navbar navbar-expand-md navbar-dark navbar-custom main-navbar sticky-top">
    <div class="container">
      <a class="navbar-brand fw-semibold" href="/">Demo</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="main-navbar">
        <ul class="navbar-nav ms-auto text-uppercase fw-bold gap-md-2">
          <li class="nav-item"><a class="nav-link js-animate active" href="#section1"><strong>Form</strong></a></li>
          <li class="nav-item"><a class="nav-link js-animate" href="#section2">Results</a></li>
          <li class="nav-item"><a class="nav-link" target="_blank" rel="noreferrer" href="https://github.com/voku/anti-xss/">GitHub</a></li>
        </ul>
      </div>
    </div>
  </nav>

  {% block content %}{% endblock %}
</div>

<footer class="footer">
  <div class="container">
    <p class="text-muted mb-0">BY <a target="_blank" rel="noreferrer" href="https://moelleken.org/">LARS MOELLEKEN</a> — refreshed for 2026</p>
  </div>
</footer>

<ul class="nav pull-right scroll-top">
  <li><a href="#top" title="Scroll to top" aria-label="Scroll to top">↑</a></li>
</ul>

{% block footer_js %}
  <script src="/js-min/app.js"></script>
{% endblock %}
</body>
</html>
